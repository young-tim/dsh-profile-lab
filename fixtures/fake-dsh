#!/usr/bin/env node
import { appendFileSync, existsSync, readFileSync, statSync } from "node:fs";
import path from "node:path";
if (process.env.FAKE_DSH_LOG)
  appendFileSync(
    process.env.FAKE_DSH_LOG,
    JSON.stringify(process.argv.slice(2)) + "\n",
  );
if (process.env.FAKE_CREDENTIAL_LOG) {
  const credentials = path.join(
    process.env.DSH_HOME ?? "",
    ".credentials.yaml",
  );
  const settings = path.join(process.env.DSH_HOME ?? "", "settings.yaml");
  appendFileSync(
    process.env.FAKE_CREDENTIAL_LOG,
    JSON.stringify({
      exists: existsSync(credentials),
      content: existsSync(credentials)
        ? readFileSync(credentials, "utf8")
        : null,
      mode: existsSync(credentials) ? statSync(credentials).mode & 0o777 : null,
      settingsExists: existsSync(settings),
      settingsContent: existsSync(settings)
        ? readFileSync(settings, "utf8")
        : null,
      settingsMode: existsSync(settings)
        ? statSync(settings).mode & 0o777
        : null,
    }) + "\n",
  );
}
const args = process.argv.slice(2);
const get = (x) => args[args.indexOf(x) + 1];
const patch = get("--patch");
const prompt = args.at(-1);
if (!get("--profile") || !patch || !prompt || !existsSync(patch)) {
  console.error("invalid official dsh invocation");
  process.exit(2);
}
const v = path.basename(patch).startsWith("base") ? "base" : "candidate";
const expected = prompt.includes("alpha")
  ? "PROFILE_LAB_ALPHA"
  : prompt.includes("beta")
    ? "PROFILE_LAB_BETA"
    : "pass";
console.log(
  JSON.stringify({
    type: "assistant/message",
    seq: 1,
    time: "2026-01-01T00:00:00Z",
    data: {
      message: {
        role: "assistant",
        content: [
          { type: "text", text: v === "base" ? expected : "regression" },
        ],
      },
      usage: { inputTokens: 20, outputTokens: 5 },
    },
  }),
);
console.log(
  JSON.stringify({
    type: "step/end",
    seq: 2,
    time: "2026-01-01T00:00:00Z",
    data: {},
  }),
);
console.log(
  JSON.stringify({
    type: "turn/end",
    seq: 3,
    time: "2026-01-01T00:00:00Z",
    data: { reason: { kind: "completed" }, duration_ms: 10, steps: 1 },
  }),
);
