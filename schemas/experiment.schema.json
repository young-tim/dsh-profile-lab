{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "cases_dir",
    "workspace_template",
    "baseline",
    "variants",
    "repetitions",
    "run"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "cases_dir": { "type": "string" },
    "workspace_template": { "type": "string" },
    "baseline": { "type": "string" },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile", "patch"],
        "properties": {
          "id": { "type": "string" },
          "profile": { "type": "string" },
          "patch": { "type": "string" }
        }
      }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "timeout_ms", "max_runs", "max_total_tokens"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_runs": { "type": "integer", "minimum": 1 },
        "max_total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "pricing": { "type": "object" },
    "gate": { "type": "object" }
  }
}
