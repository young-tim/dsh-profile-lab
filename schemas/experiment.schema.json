{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "cases_dir",
    "workspace_template",
    "baseline",
    "variants",
    "repetitions",
    "run"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "cases_dir": { "type": "string", "minLength": 1 },
    "workspace_template": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile", "patch"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "patch": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "timeout_ms", "max_runs", "max_total_tokens"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_runs": { "type": "integer", "minimum": 1 },
        "max_total_tokens": { "type": "integer", "minimum": 0 },
        "credentials": {
          "type": "string",
          "enum": ["inherit", "env-only"],
          "default": "inherit"
        },
        "env_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_per_million", "output_per_million"],
        "properties": {
          "input_per_million": { "type": "number", "minimum": 0 },
          "output_per_million": { "type": "number", "minimum": 0 }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_candidate_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_pass_rate_drop_pp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_median_token_increase_pct": { "type": "number", "minimum": 0 },
        "max_error_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeout_ms"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "env_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    }
  }
}
