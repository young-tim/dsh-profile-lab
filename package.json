{
  "name": "dsh-profile-lab",
  "version": "0.1.0",
  "description": "Reproducible local experiment matrices for DSH profiles",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "evaluation",
    "benchmark",
    "profiles"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young-tim/dsh-profile-lab.git"
  },
  "homepage": "https://github.com/young-tim/dsh-profile-lab#readme",
  "bugs": {
    "url": "https://github.com/young-tim/dsh-profile-lab/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dsh-profile-lab": "./dist/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./schemas/experiment.schema.json": "./schemas/experiment.schema.json",
    "./schemas/report.schema.json": "./schemas/report.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write src test fixtures examples schemas package.json",
    "format:check": "prettier --check src test fixtures examples schemas package.json",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage.enabled=false",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration.test.ts",
    "test:package": "vitest run test/package.test.ts",
    "prepack": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "ajv-cli": "5.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  },
  "packageManager": "pnpm@11.9.0"
}
